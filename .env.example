# Required
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_USERNAME=spacecolonybot

# Public HTTPS URL (Mini App + webhook). On Railway leave empty — uses RAILWAY_PUBLIC_DOMAIN.
WEBAPP_URL=https://your-domain.example.com
WEBHOOK_SECRET=change-me-to-random-string

PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://colony:colony@localhost:5432/space_colony
REDIS_URL=redis://localhost:6379

# Mini App short names in BotFather (multi-entry)
MINI_APP_SHORT_NAME=colony

# Telegram Stars (after BotFather Payments)
STARS_ENABLED=0
PREMIUM_PLANET_STARS=50

# Phase 3 — AI Admiral
OPENAI_API_KEY=

# Dev: long polling without webhook
USE_POLLING=0
